{
  tags = [ "gui" ];

  config =
    {
      lib,
      config,
      pkgs,
      ...
    }:
    {
      options.custom = {
        # terminal options
        programs.terminal = {
          package = lib.mkOption {
            type = lib.types.package;
            default = pkgs.ghostty;
            description = "Package to use for the terminal";
          };

          app_id = lib.mkOption {
            type = lib.types.str;
            description = "app_id (wm class) for the terminal";
          };

          desktop = lib.mkOption {
            type = lib.types.str;
            default = "${config.custom.programs.terminal.app_id}.desktop";
            description = "Name of desktop file for the terminal";
          };
        };
      };

      config = {
        # run ghostty as a background service, the package ships app-com.mitchellh.ghostty.service
        # (ghostty --gtk-single-instance=true --initial-window=false) and a dbus activation file,
        # so `ghostty +new-window` opens windows in the running instance and starts it if needed
        systemd.packages = [ config.custom.programs.terminal.package ];
        services.dbus.packages = [ config.custom.programs.terminal.package ];
        systemd.user.services."app-com.mitchellh.ghostty" = {
          wantedBy = [ "graphical-session.target" ];
          # keep the PATH of the session instead of the minimal default service PATH, shells inherit it
          enableDefaultPath = false;
          serviceConfig.Restart = "on-failure";
        };

        hj.rum.programs.ghostty = {
          enable = true;
          inherit (config.custom.programs.terminal) package;
          settings = {
            # keep the background service alive after the last window is closed
            quit-after-last-window-closed = false;
            font-family = config.custom.fonts.monospace;
            font-size = 10;
            # generated by the noctalia ghostty template in ~/.config/ghostty/themes/noctalia,
            # ghostty falls back to its default colors until the first generation
            theme = "noctalia";
            alpha-blending = "linear-corrected";
            app-notifications = "no-clipboard-copy";
            background-opacity = 0.85;
            confirm-close-surface = false;
            copy-on-select = "clipboard";
            cursor-style = "bar";
            window-decoration = false;
            window-padding-x = 12;
            window-padding-y = 8;
            window-padding-balance = true;
            font-feature = "zero";
            font-style = "Medium";
          };
        };

        custom.programs = {
          terminal = {
            # ghostty's default gtk application id, --class only accepts ids containing a dot
            app_id = "com.mitchellh.ghostty";
          };

          noctalia.settings = {
            theme.templates.builtin_ids = [ "ghostty" ];
          };
        };
      };
    };
}
