+// vmwgfx returns TTM surface handles from PRIME imports instead of GEM handles,
+// so drmCloseBufferHandle() fails with EINVAL. Release them with the vmwgfx ioctl.
+static bool close_buffer_handle(int fd, uint32_t handle) {
+	if (drmCloseBufferHandle(fd, handle) == 0) {
+		return true;
+	}
+	int close_errno = errno;
+
+	bool is_vmwgfx = false;
+	drmVersion *version = drmGetVersion(fd);
+	if (version != NULL) {
+		is_vmwgfx = strcmp(version->name, "vmwgfx") == 0;
+		drmFreeVersion(version);
+	}
+	if (is_vmwgfx) {
+		struct drm_vmw_surface_arg arg = {
+			.sid = (int32_t)handle,
+			.handle_type = DRM_VMW_HANDLE_LEGACY,
+		};
+		if (drmCommandWrite(fd, DRM_VMW_UNREF_SURFACE, &arg, sizeof(arg)) == 0) {
+			return true;
+		}
+	}
+
+	errno = close_errno;
+	return false;
+}
