+local function configBool(key, fallback)
+  local value = noctalia.getConfig(key)
+  if type(value) == "boolean" then
+    return value
+  end
+  return fallback
+end
+
+local function configSize(key)
+  local value = noctalia.getConfig(key)
+  if type(value) == "number" and value > 0 then
+    return tostring(math.floor(value))
+  end
+  return ""
+end
+
+local function downscaleToMonitor(path, done)
+  local w = configSize("resolution_width")
+  local h = configSize("resolution_height")
+  if w == "" or h == "" then
+    done()
+    return
+  end
+  local geometry = `{w}x{h}^>`
+  noctalia.runAsync(`@magick@ {shellQuote(path)} -resize {shellQuote(geometry)} {shellQuote(path)}`, function(_res)
+    done()
+  end)
+end
